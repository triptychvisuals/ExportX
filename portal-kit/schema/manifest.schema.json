{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/triptychvisuals/ExportX/portal-kit/schema/manifest.schema.json",
  "title": "ExportX batch manifest",
  "description": "Sent by ExportX as the body of POST /api/exportx/batches when a render has finished.",
  "type": "object",
  "required": ["source", "project", "files"],
  "additionalProperties": true,
  "properties": {
    "source": { "const": "exportx" },
    "exportxVersion": { "type": ["string", "null"] },
    "project": { "type": "string", "minLength": 1 },
    "timeline": { "type": ["string", "null"] },
    "fps": { "type": ["number", "null"] },
    "exportedAt": { "type": "string", "format": "date-time" },
    "namePattern": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"], "description": "Category id chosen as default in ExportX. A hint; the portal decides." },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/file" }
    }
  },
  "definitions": {
    "file": {
      "type": "object",
      "required": ["key", "fileName", "kind", "bytes"],
      "additionalProperties": true,
      "properties": {
        "key": { "type": "string", "minLength": 1, "description": "Unique within the batch; used in PUT /batches/{id}/files/{key}" },
        "fileName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["final", "cut", "still"] },
        "label": { "type": ["string", "null"] },
        "deliverableId": { "type": ["string", "null"] },
        "deliverableName": { "type": ["string", "null"] },
        "timeline": { "type": ["string", "null"] },
        "format": { "type": ["string", "null"] },
        "codec": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "tcIn": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$" },
        "tcOut": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$" },
        "durationFrames": { "type": ["integer", "null"] },
        "markIndex": { "type": ["integer", "null"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "modifiedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
